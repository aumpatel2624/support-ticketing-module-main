<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  Options -Indexes

  # 1. Handle conflict where a directory exists but we want the .html file (Shadowing)
  # If /tickets is requested, and tickets.html exists, serve tickets.html instead of the directory
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
  # Variant using REQUEST_URI to be safer
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*[^/])/?$ $1.html [L]

  # 2. Standard direct file access
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Rewrite extensionless URLs to .html (Check if .html exists)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Handle Directories: If it's a directory and we haven't rewritten it yet,
  # Check if index.html exists inside it (unlikely with trailingSlash: false, but possible for strict sub-paths)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 5. SPA Fallback for everything else
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
