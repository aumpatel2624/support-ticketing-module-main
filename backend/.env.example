# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRE=30m
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRE=7d

# Backend public URL (used for Swagger docs, file URLs, etc.)
BACKEND_URL=http://localhost:5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AWS S3 Configuration (File Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name
S3_FOLDER_PREFIX=tickets/
PRESIGNED_URL_EXPIRY=3600

# Redis (Optional - for caching/Socket.io scaling)
REDIS_URI=redis://localhost:6379

# Puppeteer (for PDF generation on Linux servers)
# Run: which chromium-browser || which chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@company.com
FROM_NAME=Support System
