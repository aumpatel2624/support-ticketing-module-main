# Production Environment Configuration
# Copy to .env.production and fill in actual values

# Server
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ticketing-production?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=generate-strong-secret-with-crypto.randomBytes(32).toString('hex')
JWT_EXPIRE=30m
JWT_REFRESH_SECRET=generate-strong-secret-with-crypto.randomBytes(32).toString('hex')
JWT_REFRESH_EXPIRE=7d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=noreply@company.com
FROM_NAME=Ticketing System Support

# Frontend CORS
FRONTEND_URL=https://ticketing.company.com

# AWS S3 Configuration (File Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=company-ticketing-uploads
S3_ACL=private
S3_FOLDER_PREFIX=prod/tickets/
PRESIGNED_URL_EXPIRY=3600

# File Upload Fallback (for local storage if S3 not available)
UPLOAD_PATH=/tmp/uploads
MAX_FILE_SIZE=5242880

# Socket.io Configuration
SOCKET_CORS_ORIGIN=https://ticketing.company.com
SOCKET_CORS_CREDENTIALS=true

# System Settings
TIMEZONE=UTC
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=24h

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5

# Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your-datadog-key

# Redis (for Socket.io scaling - optional, phase 2)
REDIS_URL=redis://:password@hostname:6379

# Features Toggle
FEATURES_ENABLED=kanban,card,table,filters,bulk,export,search
MAINTENANCE_MODE=false

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Health Check Endpoint
HEALTH_CHECK_ENABLED=true
